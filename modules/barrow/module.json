{
  "id": "barrow",
  "name": "Barrow of the Two Brothers",
  "summary": "A foolish young man went treasure hunting in the old barrow, and his parents will pay for news of him. Two dead brothers still quarrel there over their mother's crown.",
  "recommendedLevels": {
    "min": 1,
    "max": 2
  },
  "license": {
    "name": "Creative Commons Attribution-ShareAlike 3.0",
    "file": "modules/barrow/LICENSE",
    "credit": "Adapted from Barrow of the Two Brothers by L. Shaffrey (Copper Pieces), https://copperpieces.itch.io/barrow-of-the-two-brothers, under CC BY-SA 3.0. This adaptation is released under the same license. Changes: a hillside level joining the two entrances, one ghoul fewer in the Tomb of the Traitors, a Criminal background as the mark of treachery, the crown staying on the throne once a brother is crowned, and rules and wording for this game. The art was generated for this game and isn't by the author."
  },
  "titleImage": "title-barrow",
  "ruleset": "srd5",
  "start": {
    "level": "hillside",
    "x": 6,
    "y": 2,
    "dir": 1
  },
  "intro": [
    "BARROW OF THE TWO BROTHERS",
    "Anders went looking for treasure in the old barrow, and hasn't come home. His parents have offered 50 gold to whoever finds him.",
    "Fresh digging opens the mound ahead. Further along, a second entrance lies choked with rubble."
  ],
  "items": {
    "anders-diary": {
      "stays": true,
      "name": "Anders's Diary",
      "kind": "gear",
      "weight": 0.5,
      "icon": "book",
      "description": "Ends with a copied tale of two royal brothers, and a note about a magic sword buried with the younger."
    },
    "anders-thanks": {
      "unique": true,
      "name": "Letter of Thanks",
      "kind": "gear",
      "weight": 0.1,
      "icon": "scroll",
      "description": "From Anders's parents, for bringing them the truth."
    },
    "two-brothers-crown": {
      "unique": true,
      "name": "Gold Crown",
      "kind": "gear",
      "weight": 3,
      "icon": "crown",
      "description": "The dead queen's crown, worth 300 GP. Her two sons killed each other for it."
    },
    "ethelred-dagger": {
      "unique": true,
      "name": "Ethelred's Silver Dagger",
      "base": "dagger",
      "description": "A silver Dagger worth 20 GP. The blade still has a dark stain of old poison."
    },
    "traitor-torc": {
      "name": "Traitor's Torc",
      "kind": "gear",
      "weight": 1,
      "icon": "amulet",
      "cost": "10 GP",
      "description": "A silver torc worth 10 GP, inscribed 'Traitor'."
    },
    "wrath": {
      "unique": true,
      "name": "Wrath",
      "base": "longsword",
      "bonus": 1,
      "power": "wrath",
      "description": "A +1 Longsword, Olaf's enchanted blade. Once per Long Rest, while it's in your main hand, you can gain Advantage on your next attack against a target. You can attack nothing else until it or you drop to 0 HP. Add it from Skills & Spells."
    }
  },
